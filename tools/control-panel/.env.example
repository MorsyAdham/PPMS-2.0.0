# PPMS Control Panel settings. Copy to .env (git-ignored) and fill in.
# NEVER commit .env — the service key bypasses all database security.

# Supabase → Project Settings → API → service_role key
SUPABASE_SERVICE_KEY=

# Optional — only for "Saved SQL checks". Supabase → Account → Access Tokens.
SUPABASE_ACCESS_TOKEN=

